# AI Studio API (OpenAI-совместимый endpoint).
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
AI_STUDIO_API_KEY=put_your_api_key_here
AI_STUDIO_BASE_URL=https://your-ai-studio-endpoint/v1
AI_STUDIO_MODEL=your_model_name

# Необязательно (используются значения по умолчанию ниже).
DB_PATH=data/bot.sqlite3
APP_HOST=127.0.0.1
APP_PORT=8000
